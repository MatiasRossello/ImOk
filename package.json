{
  "name": "imok",
  "version": "1.4.0",
  "description": "Peer-to-peer check-ins that survive the sender going offline.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://phwgcr6uk1frfmwcmgxjzr5ho4mw9gog98e6omi4s7y9e7yigeto",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name imok --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name imok --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name imok --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name imok --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name imok --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name imok --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-console": "^6.2.0",
    "bare-daemon": "^1.2.4",
    "bare-file-logger": "^1.2.1",
    "bare-fs": "^4.7.2",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-pipe": "^4.2.1",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "bare-tty": "^5.1.2",
    "ble-swarm": "^2.1.0",
    "corestore": "^7.9.2",
    "fs-native-extensions": "^1.5.0",
    "hyperbee": "^2.27.3",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.1.4",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.1",
    "bare-runtime": "^1.29.5",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "author": "Ignacio Wuilloud",
  "license": "Apache-2.0",
  "pear": {
    "stage": {
      "ignore": [
        "/.git",
        "/out",
        "/.github",
        "/ci",
        "/node_modules/.cache",
        "/test",
        "/scripts",
        "/docs/bien-plan-de-fases.md",
        "/docs/bien-spec-implementacion.md",
        "/docs/TEMPLATE-README.md",
        "/package-lock.json",
        "/node_modules/@hyperswarm",
        "/node_modules/@jridgewell",
        "/node_modules/@types",
        "/node_modules/bare-apk",
        "/node_modules/bare-build",
        "/node_modules/bare-build-android-arm",
        "/node_modules/bare-build-android-arm64",
        "/node_modules/bare-build-android-ia32",
        "/node_modules/bare-build-android-x64",
        "/node_modules/bare-build-darwin-arm64",
        "/node_modules/bare-build-darwin-x64",
        "/node_modules/bare-build-ios-arm64",
        "/node_modules/bare-build-ios-arm64-simulator",
        "/node_modules/bare-build-ios-x64-simulator",
        "/node_modules/bare-build-linux-arm64",
        "/node_modules/bare-build-linux-x64",
